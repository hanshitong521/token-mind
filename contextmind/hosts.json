      "capabilities": { "hooks": false, "mcp": false, "failClosed": false, "outputRewrite": false },
      "detect": {
        "transcriptPaths": ["\\.codex"],
        "configDirs": ["\\.codex"],
        "eventCase": null,
        "toolPayloadKey": null,
        "mcpToolPrefix": null
      },
      "mcpClientInfo": ["codex"],
      "hooks": null,
      "mcp": null
    },
    {
      "id": "trae",
      "label": "Trae",
      "verified": true,
      "capabilities": {
        "hooks": false,
        "mcp": true,
        "failClosed": false,
        "outputRewrite": false
      },
      "hooksNote": "Measured 2026-09-13: this Trae build registers .trae/hooks.json as a context asset (file watcher) but never dispatches PreToolUse/PostToolUse to external commands — a marker hook writing a file on every Shell call never fired, and the ledger holds zero hook rows across a full session. The hooks block below stays so `install`/`fix-hooks` keep the launchers ready for a build that does dispatch; until then ALL Trae governance runs server-side: MCP tools bound their own output (ResultCache + gateText) and Brain crops to 450 tokens in-process. Read-guard and hook-side output rewrite are NOT available on Trae.",
      "detect": {
        "transcriptPaths": ["\\.trae", "\\.trae-cn"],
        "configDirs": ["\\.trae", "\\.trae-cn"],
        "eventCase": "upper",
        "toolPayloadKey": "tool_response",
        "mcpToolPrefix": null
      },
      "mcpClientInfo": ["trae"],
      "hooks": {
        "file": {
          "scope": "project",
          "path": ".trae/hooks.json",
          "keyPath": "hooks",
          "entryShape": "claude-nested",
          "leafCommandString": true,
          "rootFields": { "version": 1 }
        },
        "eventNames": {
          "preToolUse": "PreToolUse",
          "postToolUse": "PostToolUse",
          "sessionStart": "SessionStart",
          "beforeSubmitPrompt": "UserPromptSubmit",
          "stop": "Stop"
        },
        "asyncEvents": [],
        "matcherEvents": ["PreToolUse", "PostToolUse"],
        "toolMatcher": "^(Shell|RunCommand|Bash|Read|run_mcp|mcp__.*|CallMcpTool|Task|Agent)$",
        "env": { "CONTEXTMIND_HOST": "trae" }
      },
      "mcp": {
        "scope": "user",
        "path": "AppData/Roaming/Trae CN/User/mcp.json",
        "keyPath": "mcpServers",
        "entryShape": "stdio",
        "mountBrain": true,
        "cwdSupported": false,
        "fields": {}
      }
    }
  ]
}
