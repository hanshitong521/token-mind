        "configDirs": ["\\.qoder"],
        "eventCase": "upper",
        "toolPayloadKey": "tool_response",
        "mcpToolPrefix": null
      },
      "mcpClientInfo": ["qoder"],
      "hooks": {
        "file": {
          "scope": "project",
          "path": ".qoder/settings.json",
          "keyPath": "hooks",
          "entryShape": "claude-nested",
          "rootFields": {}
        },
        "eventNames": {
          "preToolUse": "PreToolUse",
          "postToolUse": "PostToolUse",
          "sessionStart": "SessionStart",
          "sessionEnd": "SessionEnd",
