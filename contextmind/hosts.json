{
  "version": 1,
  "_comment": "Host registry — single source of truth for every agent this layer governs. Adding a host should be a data change here, not an edit to install-plan/cli/runtime/telemetry. `verified` means someone checked these paths and shapes against a real install of that host; unverified profiles are advertised by doctor and refused by install, because a guessed config path silently writes governance nowhere.",
  "hosts": [
    {
      "id": "cursor",
      "label": "Cursor",
      "verified": true,
      "capabilities": {
        "hooks": true,
        "mcp": true,
        "failClosed": true,
        "outputRewrite": true
      },
      "detect": {
        "transcriptPaths": ["\\.cursor"],
        "configDirs": ["\\.cursor"],
        "eventCase": "lower",
        "toolPayloadKey": "tool_output",
        "mcpToolPrefix": "MCP:"
      },
      "mcpClientInfo": ["cursor"],
      "hooks": {
        "file": {
          "scope": "project",
          "path": ".cursor/hooks.json",
          "keyPath": "hooks",
          "entryShape": "flat",
          "rootFields": { "version": 1 }
        },
        "eventNames": "identity",
        "asyncEvents": [],
        "matcherEvents": null,
        "toolMatcher": null,
        "env": {}
      },
      "mcp": {
        "scope": "project",
        "path": ".cursor/mcp.json",
        "keyPath": "mcpServers",
        "entryShape": "stdio",
        "mountBrain": true,
        "fields": {}
      }
    },
    {
